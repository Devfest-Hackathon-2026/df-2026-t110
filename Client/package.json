{
  "name": "programming-learning-ar-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "generate:api:check": "node scripts/generate-api.mjs --check",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@iconify-icons/lucide": "^2.0.27",
    "@iconify/vue": "^5.0.5",
    "@vue/devtools-api": "^8.2.1",
    "blockly": "^13.4.0",
    "openapi-fetch": "0.16.0",
    "pinia": "^4.1.0",
    "three": "^0.180.0",
    "vue": "^3.5.0",
    "vue3-carousel": "^0.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "jiti": "^2.7.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8",
    "vue-tsc": "^3.3.14"
  }
}
