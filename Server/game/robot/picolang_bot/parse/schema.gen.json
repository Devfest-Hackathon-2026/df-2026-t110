      "required": [
        "kind",
        "hintId",
        "type",
        "value"
      ],
      "title": "BoolLiteral",
      "type": "object"
    },
    "v0/call.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "関数名と実引数の一覧による関数呼び出し",
      "properties": {
        "args": {
          "$ref": "#/$defs/v0~1args.yaml"
        },
        "func": {
          "$ref": "#/$defs/v0~1func.yaml"
        },
        "hintId": {
          "$ref": "#/$defs/v0~1hint-id.yaml"
        },
        "kind": {
          "const": "call"
        }
      },
      "required": [
        "kind",
        "hintId",
        "func",
        "args"
      ],
      "title": "Call",
      "type": "object"
    },
    "v0/compound-type.yaml": {
