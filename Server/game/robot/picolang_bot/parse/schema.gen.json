        {
          "$ref": "#/$defs/v0~1stack-type.yaml"
        },
        {
          "$ref": "#/$defs/v0~1option-type.yaml"
        }
      ],
      "title": "CompoundType"
    },
    "v0/distance-target-literal.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "distance_target 型のリテラル",
      "properties": {
        "hintId": {
          "$ref": "#/$defs/v0~1hint-id.yaml"
        },
        "kind": {
          "const": "literal"
        },
        "type": {
          "const": "distance_target"
        },
        "value": {
          "$ref": "#/$defs/v0~1distance-target.yaml"
        }
      },
      "required": [
        "kind",
        "hintId",
        "type",
        "value"
      ],
      "title": "DistanceTargetLiteral",
      "type": "object"
    },
    "v0/distance-target.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "distance で探す対象の種類",
      "enum": [
        "robot",
        "ally",
        "enemy",
        "rock",
        "luggage",
        "sea",
        "goal",
        "territory"
      ],
      "title": "DistanceTarget",
      "type": "string"
    },
    "v0/expr.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "リテラル、変数参照、関数呼び出しのいずれかの式",
      "oneOf": [
        {
          "$ref": "#/$defs/v0~1literal.yaml"
        },
        {
          "$ref": "#/$defs/v0~1ident.yaml"
        },
        {
          "$ref": "#/$defs/v0~1call.yaml"
        }
      ],
      "title": "Expr"
    },
    "v0/func.yaml": {
      "$ref": "#/$defs/v0~1name.yaml",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "呼び出す組み込み関数またはユーザー定義関数の名前。関数は値として扱わない",
      "title": "Func"
    },
    "v0/function.schema.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "引数、戻り値の型、関数本体を持つ関数定義。関数名は picolang.v0.program map のキーで表す",
      "properties": {
        "body": {
          "$ref": "#/$defs/v0~1block.yaml"
        },
        "hintId": {
          "$ref": "#/$defs/v0~1hint-id.yaml"
        },
        "kind": {
          "const": "function"
        },
        "params": {
          "description": "宣言順に並べた引数の一覧",
          "items": {
            "$ref": "#/$defs/v0~1param.yaml"
          },
          "type": "array"
        },
        "returnType": {
          "$ref": "#/$defs/v0~1type.yaml"
        }
      },
      "required": [
        "kind",
        "hintId",
        "params",
        "returnType",
        "body"
      ],
      "title": "PicolangFunctionDefinition",
      "type": "object"
    },
    "v0/hint-id.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "構文ノードに対応するデバッグ用 UUID。プログラム全体での一意性は意味解析で検査する",
      "format": "uuid",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "title": "HintId",
      "type": "string"
    },
    "v0/ident.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "変数の参照または宣言・代入・for 文における変数名",
      "properties": {
        "hintId": {
          "$ref": "#/$defs/v0~1hint-id.yaml"
        },
        "kind": {
          "const": "ident"
        },
        "name": {
          "$ref": "#/$defs/v0~1name.yaml"
        }
      },
      "required": [
        "kind",
        "hintId",
        "name"
      ],
      "title": "Ident",
      "type": "object"
    },
    "v0/integer-literal.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "integer 型のリテラル",
      "properties": {
        "hintId": {
          "$ref": "#/$defs/v0~1hint-id.yaml"
        },
        "kind": {
          "const": "literal"
        },
        "type": {
          "const": "integer"
        },
        "value": {
          "description": "i64 の範囲外の値の扱いは未定義",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "hintId",
        "type",
        "value"
      ],
      "title": "IntegerLiteral",
      "type": "object"
    },
    "v0/literal.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "bool、integer、unit、rotation、distance_target のリテラル。terrain 型にはリテラルがない",
      "oneOf": [
        {
          "$ref": "#/$defs/v0~1bool-literal.yaml"
        },
        {
          "$ref": "#/$defs/v0~1integer-literal.yaml"
        },
        {
          "$ref": "#/$defs/v0~1unit-literal.yaml"
        },
        {
          "$ref": "#/$defs/v0~1rotation-literal.yaml"
        },
        {
          "$ref": "#/$defs/v0~1distance-target-literal.yaml"
        }
      ],
      "title": "Literal"
    },
    "v0/name.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "変数や関数の名前。使用できる文字の制限は未定義のため、空でない文字列とする",
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "v0/option-type.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "型Tの値を持つsome、または値を持たないnoneを表す型",
      "properties": {
        "elementType": {
          "$ref": "#/$defs/v0~1type.yaml",
          "description": "someが持つ値の型。基本型と複合型のどちらも指定できる"
        },
        "kind": {
          "const": "option",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "elementType"
      ],
      "title": "OptionType",
      "type": "object"
    },
    "v0/param.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "関数の仮引数の名前と型",
      "properties": {
        "hintId": {
          "$ref": "#/$defs/v0~1hint-id.yaml"
        },
        "ident": {
          "$ref": "#/$defs/v0~1ident.yaml"
        },
        "kind": {
          "const": "param"
        },
        "type": {
          "$ref": "#/$defs/v0~1type.yaml"
        }
      },
      "required": [
        "kind",
        "hintId",
        "ident",
        "type"
      ],
      "title": "Param",
      "type": "object"
    },
    "v0/primitive-type.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "picolang の基本型。unit は () を表す",
      "enum": [
        "bool",
        "integer",
        "unit",
        "terrain",
        "rotation",
        "distance_target"
      ],
      "title": "PrimitiveType",
      "type": "string"
    },
    "v0/program.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {
        "$ref": "#/$defs/v0~1function.schema.yaml"
      },
      "description": "関数名をキー、関数定義を値とする文法バージョン 0 のプログラム",
      "propertyNames": {
        "$ref": "#/$defs/v0~1name.yaml"
      },
      "title": "PicolangV0Program",
      "type": "object"
    },
    "v0/rotation-literal.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "rotation 型のリテラル",
      "properties": {
        "hintId": {
          "$ref": "#/$defs/v0~1hint-id.yaml"
        },
        "kind": {
          "const": "literal"
        },
        "type": {
          "const": "rotation"
        },
        "value": {
          "enum": [
            "left",
            "right"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "hintId",
        "type",
        "value"
      ],
      "title": "RotationLiteral",
      "type": "object"
    },
    "v0/stack-type.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "同じ型の要素を持つ連結リストで表現するスタックの型",
      "properties": {
        "elementType": {
          "$ref": "#/$defs/v0~1type.yaml",
          "description": "要素の型。基本型と複合型のどちらも指定できる"
        },
        "kind": {
          "const": "stack",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "elementType"
      ],
      "title": "StackType",
      "type": "object"
    },
    "v0/stmt.yaml": {
      "$defs": {
        "Assignment": {
          "additionalProperties": false,
          "description": "既存の変数への代入",
          "properties": {
            "hintId": {
              "$ref": "#/$defs/v0~1hint-id.yaml"
            },
            "ident": {
              "$ref": "#/$defs/v0~1ident.yaml"
            },
            "kind": {
              "const": "assign"
            },
            "value": {
              "$ref": "#/$defs/v0~1expr.yaml"
            }
          },
          "required": [
            "kind",
            "hintId",
            "ident",
            "value"
          ],
          "type": "object"
        },
        "Break": {
          "additionalProperties": false,
          "description": "最も内側のループを終了する",
          "properties": {
            "hintId": {
              "$ref": "#/$defs/v0~1hint-id.yaml"
            },
            "kind": {
              "const": "break"
            }
          },
          "required": [
            "kind",
            "hintId"
          ],
          "type": "object"
        },
        "Continue": {
          "additionalProperties": false,
          "description": "最も内側のループの次の反復に進む",
          "properties": {
            "hintId": {
              "$ref": "#/$defs/v0~1hint-id.yaml"
            },
            "kind": {
              "const": "continue"
            }
          },
          "required": [
            "kind",
            "hintId"
          ],
          "type": "object"
        },
        "Declaration": {
          "additionalProperties": false,
          "description": "型と初期値を指定した変数宣言",
          "properties": {
            "hintId": {
              "$ref": "#/$defs/v0~1hint-id.yaml"
            },
            "ident": {
              "$ref": "#/$defs/v0~1ident.yaml"
            },
            "kind": {
              "const": "declare"
            },
            "type": {
              "$ref": "#/$defs/v0~1type.yaml"
            },
            "value": {
              "$ref": "#/$defs/v0~1expr.yaml"
            }
          },
          "required": [
            "kind",
            "hintId",
            "type",
            "ident",
            "value"
          ],
          "type": "object"
        },
        "For": {
          "additionalProperties": false,
          "description": "integer 型の start から end までの半開区間を繰り返す。start が end 以上の場合は実行しない。ループ変数への代入は次の反復に影響しない",
          "properties": {
            "body": {
              "$ref": "#/$defs/v0~1block.yaml"
            },
            "end": {
              "$ref": "#/$defs/v0~1expr.yaml"
            },
            "hintId": {
              "$ref": "#/$defs/v0~1hint-id.yaml"
            },
            "ident": {
              "$ref": "#/$defs/v0~1ident.yaml"
            },
            "kind": {
              "const": "for"
            },
            "start": {
              "$ref": "#/$defs/v0~1expr.yaml"
            }
          },
          "required": [
            "kind",
            "hintId",
            "ident",
            "start",
            "end",
            "body"
          ],
          "type": "object"
        },
        "If": {
          "additionalProperties": false,
          "description": "bool 型の条件による分岐。else を省略した場合は偽のときに何も実行しない",
          "properties": {
            "condition": {
              "$ref": "#/$defs/v0~1expr.yaml"
