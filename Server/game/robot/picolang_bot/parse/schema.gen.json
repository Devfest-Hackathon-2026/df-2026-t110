        {
          "$ref": "#/$defs/header_v0~1signature-type.yaml/$defs/StackType"
        },
        {
          "$ref": "#/$defs/header_v0~1signature-type.yaml/$defs/OptionType"
        },
        {
          "$ref": "#/$defs/header_v0~1signature-type.yaml/$defs/TypeParameter"
        }
      ],
      "title": "PicolangV0SignatureType"
    },
    "header_v0/signature.schema.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "組み込み関数の引数型と戻り値型。型パラメータのスコープはこのシグネチャ内とし、呼び出しごとに具体的な型を推論する",
      "properties": {
        "params": {
          "description": "呼び出し時の引数順に並べた型の一覧。引数なしの場合は空配列",
          "items": {
            "$ref": "#/$defs/header_v0~1signature-type.yaml"
          },
          "type": "array"
        },
        "returnType": {
          "$ref": "#/$defs/header_v0~1signature-type.yaml",
          "description": "戻り値の型。値を返さない関数は unit"
        },
        "typeParameters": {
          "description": "このシグネチャで宣言する型パラメータ名。省略時は型パラメータなし。シグネチャ内で参照する型パラメータはすべてここで宣言しなければならない",
          "items": {
            "$ref": "#/$defs/v0~1name.yaml"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "params",
        "returnType"
      ],
      "title": "PicolangV0BuiltinSignature",
      "type": "object"
    },
    "toplevel.schema.yaml": {
      "$defs": {
        "Version0": {
          "additionalProperties": false,
          "description": "文法バージョン 0 と picolang.v0.program の組。他のバージョンとの同時指定は許可しない",
          "properties": {
            "picolang": {
              "additionalProperties": false,
              "description": "文法バージョン 0 のプログラムのみを指定する",
              "properties": {
                "v0": {
                  "additionalProperties": false,
                  "description": "文法バージョン 0 のプログラム",
                  "properties": {
                    "program": {
                      "$ref": "#/$defs/v0~1program.yaml"
                    }
                  },
                  "required": [
                    "program"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "v0"
              ],
              "type": "object"
            },
            "picolangVersion": {
              "const": 0,
              "description": "picolang の文法のバージョン。0 から始まり、バージョン更新ごとに 1 ずつ増やす整数",
              "type": "integer"
            }
          },
          "required": [
            "picolangVersion",
            "picolang"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "文法のバージョンと対応するプログラムを組にして、いずれか一つを指定する picolang プログラム全体のスキーマ定義",
      "oneOf": [
        {
          "$ref": "#/$defs/toplevel.schema.yaml/$defs/Version0"
        }
      ],
      "title": "PicolangProgram"
    },
    "v0/args.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "関数呼び出しの実引数。空配列は引数なしを表し、先頭から順に評価する",
      "items": {
        "$ref": "#/$defs/v0~1expr.yaml"
      },
      "title": "Args",
      "type": "array"
    },
    "v0/block.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "文の一覧と変数スコープを持つブロック",
