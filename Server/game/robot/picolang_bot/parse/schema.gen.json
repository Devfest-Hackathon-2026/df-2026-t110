  "$defs": {
    "header_v0/header.schema.yaml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "picolang v0 の組み込み関数一覧。関数名は一覧内で一意でなければならない",
      "examples": [
        [
          {
            "name": "forward",
            "signature": {
              "params": [],
              "returnType": "bool"
            },
            "tags": [
              "movement"
            ]
          },
          {
            "name": "distance",
            "signature": {
              "params": [
                "distance_target"
              ],
              "returnType": "integer"
            },
            "tags": [
              "sensing"
            ]
          },
          {
            "name": "push_back",
            "signature": {
              "params": [
                {
                  "elementType": {
                    "kind": "type_parameter",
                    "name": "T"
                  },
                  "kind": "stack"
                },
                {
                  "kind": "type_parameter",
                  "name": "T"
                }
              ],
              "returnType": {
                "elementType": {
                  "kind": "type_parameter",
                  "name": "T"
                },
                "kind": "stack"
              },
              "typeParameters": [
                "T"
              ]
            },
            "tags": [
              "stack"
            ]
          }
        ]
      ],
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/v0~1name.yaml",
            "description": "プログラムの call.func に指定する組み込み関数名"
          },
          "signature": {
            "$ref": "#/$defs/header_v0~1signature.schema.yaml"
          },
          "tags": {
            "description": "UI 上の表示先を識別するタグ。表示文言ではなく識別子を指定し、複数の表示先に属する場合は複数指定する",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "signature",
          "tags"
        ],
        "type": "object"
      },
      "title": "PicolangV0Header",
      "type": "array"
    },
    "header_v0/signature-type.yaml": {
      "$defs": {
        "OptionType": {
          "additionalProperties": false,
          "properties": {
            "elementType": {
              "$ref": "#/$defs/header_v0~1signature-type.yaml"
            },
            "kind": {
              "const": "option",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "elementType"
          ],
          "type": "object"
        },
        "StackType": {
          "additionalProperties": false,
          "properties": {
            "elementType": {
              "$ref": "#/$defs/header_v0~1signature-type.yaml"
            },
            "kind": {
              "const": "stack",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "elementType"
          ],
          "type": "object"
        },
        "TypeParameter": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "type_parameter",
              "type": "string"
            },
            "name": {
              "$ref": "#/$defs/v0~1name.yaml",
              "description": "同じシグネチャの typeParameters で宣言した名前。同名の参照は同じ型を表す"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "シグネチャ内の型。既存の基本型、再帰的な stack と option、または型パラメータの参照",
      "oneOf": [
        {
          "$ref": "#/$defs/v0~1primitive-type.yaml"
